#!/usr/bin/env python3
"""Run nedtransients without installing it.

The NED team's machines have no way to install packages, so there is no console
entry point. This puts the directory holding it on the path and calls main().
Copy the whole ``python/`` directory anywhere and this keeps working.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from nedtransients.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
