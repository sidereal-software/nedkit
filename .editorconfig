root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.nm]
indent_size = 4

# X resource files use tabs for macro body indentation.
[*.rc]
indent_style = tab
